#############################
# Payload / Database
#############################

# Required. Change in production.
PAYLOAD_SECRET="REPLACE_ME"

# Optional locally (defaults to sqlite file:./payload.db). Required on Vercel/Supabase.
# Example: postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URI="REPLACE_ME"

#############################
# Email (Resend)
#############################

# Required for transactional emails and Instagram integration alerts.
RESEND_API_KEY="REPLACE_ME"

# Optional sender override. On Vercel, the default is no-reply@ followed by the
# custom VERCEL_PROJECT_PRODUCTION_URL. Generated *.vercel.app domains are ignored;
# outside Vercel, the canonical site domain is used.
# RESEND_FROM_ADDRESS="no-reply@theweddingtimesberlin.de"

#############################
# OpenAI / LangChain
#############################

OPENAI_API_KEY="REPLACE_ME"

# Optional. Defaults to gpt-4o-mini if unset.
OPENAI_MODEL="gpt-4o-mini"

# Optional. Image generation model (defaults to gpt-image-1.5).
OPENAI_IMAGE_MODEL="gpt-image-1.5"

# Optional. Fallback model for JSON repair (defaults to gpt-4o-mini).
OPENAI_REPAIR_MODEL="gpt-4o-mini"

# Optional. Model for generating fictional authors (defaults to gpt-4o-mini).
OPENAI_AUTHOR_MODEL="gpt-4o-mini"

# Optional. Model for satire brief generation (defaults to OPENAI_MODEL).
OPENAI_BRIEF_MODEL="gpt-4o-mini"

# Optional. Model for satire critique scoring (defaults to OPENAI_REPAIR_MODEL, then OPENAI_MODEL).
OPENAI_CRITIC_MODEL="gpt-4o-mini"

# Optional. Model for critique-driven rewrite pass (defaults to OPENAI_MODEL).
OPENAI_REWRITE_MODEL="gpt-4o-mini"

# Optional. Translation pass model (defaults to OPENAI_REPAIR_MODEL).
OPENAI_TRANSLATE_MODEL="gpt-4o-mini"

# Optional tone profile for generated satire: balanced | acidic | merciless (default: acidic).
OPENAI_TONE_PROFILE="acidic"

# Optional rewrite trigger threshold (1-10). If critique is below this score, one rewrite pass runs.
SATIRE_MIN_CRITIQUE_SCORE="7"

# Optional. Enables satire brief generation before article writing.
# Disabled by default to reduce per-article latency and token cost.
SATIRE_BRIEF_ENABLED="false"

# Optional. Enables critique + rewrite pass after first draft generation.
# Disabled by default to keep per-article latency low and avoid timeout risk.
SATIRE_CRITIQUE_ENABLED="false"

# Optional. Draft-stage model for headline/subheadline/excerpt pitch generation.
# Falls back to OPENAI_ANALYSIS_MODEL, then OPENAI_MODEL.
OPENAI_DRAFT_MODEL="gpt-4o-mini"

# Optional. Draft-stage evaluator model for tone/funniness/merciless scoring.
# Falls back to OPENAI_ANALYSIS_MODEL, then OPENAI_MODEL.
OPENAI_DRAFT_EVAL_MODEL="gpt-4o-mini"

# Optional. Minimum draft pitch score thresholds (1-10) used before full article generation.
DRAFT_MIN_FUN_SCORE="6"
DRAFT_MIN_MERCILESS_SCORE="6"
DRAFT_MIN_SPECIFICITY_SCORE="6"

# Optional. TTL (hours) for cached blacklist summaries used by article generation.
BLACKLIST_SUMMARY_CACHE_TTL_HOURS="24"

# Optional. Fraction (0..1) of cache reads that trigger expired-row cleanup.
BLACKLIST_SUMMARY_CACHE_PRUNE_CHANCE="0.2"

# Optional. Max cache rows scanned per cleanup run.
BLACKLIST_SUMMARY_CACHE_PRUNE_SCAN_LIMIT="200"

#############################
# RSS (optional overrides)
#############################

# Explicit Berliner Zeitung RSS feed URL (required if you want Berliner Zeitung topics)
RSS_BERLINER_ZEITUNG_FEED="REPLACE_ME_OR_LEAVE_EMPTY"

# Optional override (default is NYT HomePage RSS)
RSS_NYTIMES_FEED=""

#############################
# Storage Provider
#############################

# Which storage provider to use: 'supabase' or 'cloudflare' (default: supabase)
STORAGE_PROVIDER="supabase"

#############################
# Supabase Storage (required if STORAGE_PROVIDER=supabase)
#############################

SUPABASE_URL="REPLACE_ME"
SUPABASE_SERVICE_ROLE_KEY="REPLACE_ME"
SUPABASE_BUCKET="REPLACE_ME"

#############################
# Cloudflare R2 Storage (required if STORAGE_PROVIDER=cloudflare)
#############################

# Your Cloudflare account ID (found in dashboard URL or overview page)
R2_ACCOUNT_ID="REPLACE_ME"

# R2 API token credentials (create at Cloudflare dashboard > R2 > Manage R2 API Tokens)
R2_ACCESS_KEY_ID="REPLACE_ME"
R2_SECRET_ACCESS_KEY="REPLACE_ME"

# R2 bucket name
R2_BUCKET_NAME="REPLACE_ME"

# Public URL for R2 bucket (custom domain or r2.dev subdomain)
# Example: https://images.yourdomain.com or https://pub-xxx.r2.dev
R2_PUBLIC_URL="REPLACE_ME"

#############################
# Image Proxy (optional)
#############################

# Enable the image proxy to hide bucket URLs from end users.
# When enabled, images can be served through /api/images/... instead of direct bucket URLs.
# Note: This routes traffic through Vercel, which may have bandwidth limits.
# Best used with Cloudflare R2 (free egress) to avoid double-billing.
IMAGE_PROXY_ENABLED="false"

#############################
# Vercel Cron
#############################

# Required in production. Vercel sends this as Authorization header.
CRON_SECRET="REPLACE_ME"

# Number of articles to generate per cron run (default: 8)
# Hobby plans only run cron once/day, so generate more per run
ARTICLES_PER_RUN="8"

# Optional. Max retries for draft pitch generation after evaluation/repetition failures (default: 2).
DRAFT_MAX_RETRIES="2"

# Optional. Max retries for full-article generation per accepted draft (default: 3).
GENERATION_MAX_ATTEMPTS="3"

# Optional. If true, cron finalization calls internal Instagram publish endpoint for created slugs.
# If false, no automatic cron-time Instagram publish happens. (default: false)
CRON_AUTO_PUBLISH_INSTAGRAM="false"

#############################
# Push Notifications (VAPID)
#############################

# Generate VAPID keys with: npx web-push generate-vapid-keys
# Required for push notifications to work

# Public key (safe to expose to clients)
VAPID_PUBLIC_KEY="REPLACE_ME"

# Private key (keep secret, server-side only)
VAPID_PRIVATE_KEY="REPLACE_ME"

# Contact email for VAPID (mailto: prefix required)
VAPID_EMAIL="mailto:admin@example.com"

#############################
# Author Pool (optional)
#############################

# Minimum number of authors to maintain (default: 8)
MIN_AUTHOR_POOL="8"

# Max new authors to generate per run (default: 3)
MAX_NEW_AUTHORS_PER_RUN="3"

#############################
# Instagram (optional)
#############################

# Set to "true" to auto-post to Instagram when an article is created or published.
# Requires Instagram Business/Creator account linked to a Facebook Page.
INSTAGRAM_ENABLED="false"

# Optional. Legacy hook-based auto-post directly from article afterChange (default: false).
# Keep false if using CRON_AUTO_PUBLISH_INSTAGRAM to avoid double posting.
INSTAGRAM_AUTO_POST_ON_ARTICLE_CREATE="false"

# Long-lived Instagram access token with content publishing permission.
# This is the seed/fallback token; refreshed tokens are stored encrypted in Payload.
INSTAGRAM_ACCESS_TOKEN="REPLACE_ME"

# Stable secret used to encrypt refreshed Instagram tokens stored in Payload.
# Generate with: openssl rand -hex 32
INSTAGRAM_TOKEN_ENCRYPTION_KEY="REPLACE_ME"

# Optional recipient for Instagram failure and recovery alerts.
# Defaults to miltonlaufer@gmail.com.
# INSTAGRAM_ALERT_EMAIL="miltonlaufer@gmail.com"

# Instagram Graph API user ID returned by /me for the token above.
INSTAGRAM_IG_USER_ID="REPLACE_ME"

# Optional: Facebook Place/Page ID to tag posts with a location (e.g. "Wedding, Berlin").
# Find the ID via Graph API Explorer or Pages Search API (search for the place name).
# INSTAGRAM_LOCATION_ID="REPLACE_WITH_PLACE_PAGE_ID"
